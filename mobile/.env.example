# Leave empty in development to auto-detect the Expo host.
# Android emulator fallback: http://10.0.2.2:3000
# iOS simulator fallback: http://localhost:3000
# Physical device: http://YOUR_LAN_IP:3000
#
# Production/preview builds MUST set a public HTTPS API URL.
# Do not ship localhost in a production APK/AAB.
# Google Drive credentials stay on the backend. Never add GOOGLE_DRIVE_* keys here.
EXPO_PUBLIC_API_URL=
