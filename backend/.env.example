NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# Firestore (text records). Files still go to Google Drive.
# Use the same Google Cloud project as Drive if you already have one.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional instead of CLIENT_EMAIL + PRIVATE_KEY: paste the full service-account JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=

# JWT — replace these values before going to production
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Private Google Drive storage for passport, visa, and employee documents.
# Leave these empty in development to use local STORAGE_LOCAL_DIR.
# Never put these values in the mobile app.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# Upload validation
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png

# Local private file storage used when Google Drive is not configured
STORAGE_LOCAL_DIR=storage

# Document expiry warning window used by VALID / EXPIRING_SOON / EXPIRED
DOCUMENT_EXPIRY_WARNING_DAYS=30
DOCUMENT_EXPIRY_URGENT_DAYS=7
DOCUMENT_EXPIRY_CRON=0 7 * * *
DOCUMENT_EXPIRY_TIMEZONE=UTC
DOCUMENT_EXPIRY_CHECK_ON_BOOT=true

# Payroll: unpaid leave daily rate = basicSalary / workingDaysPerMonth
PAYROLL_WORKING_DAYS_PER_MONTH=26

# Customer invoices (independent of employee payroll)
INVOICE_NUMBER_PREFIX=INV
INVOICE_OVERDUE_CRON=0 8 * * *
INVOICE_OVERDUE_TIMEZONE=UTC
INVOICE_OVERDUE_CHECK_ON_BOOT=true

# Shown on invoices, payslips, and report exports when configured
COMPANY_NAME=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=

# Server-side backups (never expose restore over HTTP)
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7
