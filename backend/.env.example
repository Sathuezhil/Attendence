NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/employee_management?schema=public

# JWT — replace these values before going to production
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# Private object storage for passport, visa, document, and invoice files
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_BACKUP_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Upload validation
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png
