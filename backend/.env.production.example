NODE_ENV=production
PORT=3000
CORS_ORIGIN=https://your-admin-origin.example

# Firestore
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Use unique secrets of at least 32 characters. Never reuse the development placeholders.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Required in production: private Google Drive folder for documents and Firestore JSON dumps.
# Never put these values in the mobile app or commit real credentials.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_UPLOAD_MIME_TYPES=application/pdf,image/jpeg,image/png
STORAGE_LOCAL_DIR=storage

DOCUMENT_EXPIRY_WARNING_DAYS=30
DOCUMENT_EXPIRY_URGENT_DAYS=7
DOCUMENT_EXPIRY_CRON=0 7 * * *
DOCUMENT_EXPIRY_TIMEZONE=UTC
DOCUMENT_EXPIRY_CHECK_ON_BOOT=true

PAYROLL_WORKING_DAYS_PER_MONTH=26

INVOICE_NUMBER_PREFIX=INV
INVOICE_OVERDUE_CRON=0 8 * * *
INVOICE_OVERDUE_TIMEZONE=UTC
INVOICE_OVERDUE_CHECK_ON_BOOT=true

COMPANY_NAME=
COMPANY_EMAIL=
COMPANY_PHONE=
COMPANY_ADDRESS=

BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7
