generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  ON_LEAVE
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  LEAVE
  HOLIDAY
}

enum AttendanceSource {
  MANUAL
  QR
  GPS
}

enum InvoiceStatus {
  PAID
  PENDING
  CANCELLED
}

enum DocumentType {
  PASSPORT_SCAN
  VISA_SCAN
  CONTRACT
  NATIONAL_ID
  OTHER
}

enum BackupType {
  DATABASE
  DOCUMENTS
  FULL
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum AppSettingKey {
  VISA_EXPIRY_REMINDER_DAYS
  PASSPORT_EXPIRY_REMINDER_DAYS
  ATTENDANCE_HOURS
}

/// Boss/admin account. passwordHash and twoFactorSecret must never be returned by the API.
model User {
  id               String         @id @default(uuid())
  name             String
  email            String         @unique
  passwordHash     String         @map("password_hash")
  role             Role           @default(ADMIN)
  twoFactorEnabled Boolean        @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?        @map("two_factor_secret")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Important employee records are archived via deletedAt, not hard-deleted by default.
model Employee {
  id             String         @id @default(uuid())
  employeeCode   String         @unique @map("employee_code")
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  email          String?        @unique
  phone          String?
  alternatePhone String?        @map("alternate_phone")
  dateOfBirth    DateTime?      @map("date_of_birth") @db.Date
  gender         Gender?
  nationality    String?
  address        String?
  jobTitle       String?        @map("position")
  department     String?
  joiningDate    DateTime?      @map("joining_date") @db.Date
  salary         Decimal?       @map("salary") @db.Decimal(12, 2)
  status         EmployeeStatus @default(ACTIVE)
  profileImageUrl String?       @map("profile_image_url")
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  passports      Passport[]
  visas          Visa[]
  attendances    Attendance[]
  invoices       Invoice[]
  documents      Document[]

  @@index([status])
  @@index([department])
  @@index([firstName])
  @@index([lastName])
  @@index([phone])
  @@index([jobTitle])
  @@index([deletedAt])
  @@map("employees")
}

/// documentUrl stores a private object-storage key, never a public file URL or binary data.
model Passport {
  id             String    @id @default(uuid())
  employeeId     String    @map("employee_id")
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  passportNumber String?   @unique @map("passport_number")
  issueDate      DateTime? @map("issue_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  documentUrl    String?   @map("document_url")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeId])
  @@index([expiryDate])
  @@map("passports")
}

/// documentUrl stores a private object-storage key, never a public file URL or binary data.
model Visa {
  id          String    @id @default(uuid())
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  visaNumber  String?   @map("visa_number")
  visaType    String?   @map("visa_type")
  issueDate   DateTime? @map("issue_date") @db.Date
  expiryDate  DateTime? @map("expiry_date") @db.Date
  documentUrl String?   @map("document_url")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeId])
  @@index([expiryDate])
  @@index([visaNumber])
  @@map("visas")
}

/// source defaults to MANUAL. QR/GPS can be added later without changing the core attendance model.
/// One attendance row per employee per working date. Absence is calculated dynamically when no row exists.
model Attendance {
  id             String           @id @default(uuid())
  employeeId     String           @map("employee_id")
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  date           DateTime         @db.Date
  status         AttendanceStatus
  checkIn        DateTime?        @map("check_in") @db.Timestamptz(6)
  checkOut       DateTime?        @map("check_out") @db.Timestamptz(6)
  lateMinutes    Int?             @map("late_minutes")
  workingMinutes Int?             @map("working_minutes")
  notes          String?
  source         AttendanceSource @default(MANUAL)
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("attendances")
}

/// documentUrl stores a private object-storage key, never a public file URL or binary data.
model Invoice {
  id            String        @id @default(uuid())
  employeeId    String        @map("employee_id")
  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  invoiceNumber String        @unique @map("invoice_number")
  invoiceMonth  Int           @map("invoice_month")
  invoiceYear   Int           @map("invoice_year")
  amount        Decimal       @db.Decimal(12, 2)
  vatAmount     Decimal       @default(0) @map("vat_amount") @db.Decimal(12, 2)
  totalAmount   Decimal       @map("total_amount") @db.Decimal(12, 2)
  status        InvoiceStatus @default(PENDING)
  invoiceDate   DateTime      @map("invoice_date") @db.Date
  paymentDate   DateTime?     @map("payment_date") @db.Date
  documentUrl   String?       @map("document_url")
  notes         String?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeId])
  @@index([status])
  @@index([invoiceYear, invoiceMonth])
  @@map("invoices")
}

/// fileUrl stores a private object-storage key. File bytes are never stored in PostgreSQL.
model Document {
  id           String       @id @default(uuid())
  employeeId   String       @map("employee_id")
  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  documentType DocumentType @map("document_type")
  fileName     String       @map("file_name")
  fileUrl      String       @map("file_url")
  fileSize     Int          @map("file_size")
  mimeType     String       @map("mime_type")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeId])
  @@index([documentType])
  @@map("documents")
}

/// A backup may only be marked COMPLETED after the full backup process finishes successfully.
model BackupLog {
  id              String       @id @default(uuid())
  backupType      BackupType   @map("backup_type")
  status          BackupStatus
  fileName        String?      @map("file_name")
  storageLocation String?      @map("storage_location")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(6)
  errorMessage    String?      @map("error_message")

  @@index([status])
  @@index([createdAt])
  @@map("backup_logs")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AppSetting {
  id        String        @id @default(uuid())
  key       AppSettingKey @unique
  value     Json
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}
