generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  ON_LEAVE
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  LEAVE
  HOLIDAY
}

enum AttendanceSource {
  MANUAL
  QR
  GPS
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum DocumentType {
  PASSPORT
  VISA
  EMIRATES_ID
  WORK_PERMIT
  LABOUR_CONTRACT
  INSURANCE
  OTHER
  PASSPORT_SCAN
  VISA_SCAN
  CONTRACT
  NATIONAL_ID
}

enum BackupType {
  DATABASE
  DOCUMENTS
  FULL
}

enum BackupStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum LeaveType {
  ANNUAL
  SICK
  UNPAID
  EMERGENCY
  OTHER
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  DOCUMENT_EXPIRING
  DOCUMENT_EXPIRED
  LEAVE_APPROVED
  LEAVE_REJECTED
  ATTENDANCE_ALERT
}

enum PayrollPaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum AppSettingKey {
  VISA_EXPIRY_REMINDER_DAYS
  PASSPORT_EXPIRY_REMINDER_DAYS
  ATTENDANCE_HOURS
  DOCUMENT_EXPIRY_WARNING_DAYS
  DOCUMENT_EXPIRY_URGENT_DAYS
  PAYROLL_WORKING_DAYS_PER_MONTH
}

/// Boss/admin account. passwordHash and twoFactorSecret must never be returned by the API.
model User {
  id               String         @id @default(uuid())
  name             String
  email            String         @unique
  passwordHash     String         @map("password_hash")
  role             Role           @default(ADMIN)
  twoFactorEnabled Boolean        @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?        @map("two_factor_secret")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  refreshTokens    RefreshToken[]
  auditLogs        AuditLog[]
  approvedLeaves   Leave[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Important employee records are archived via deletedAt, not hard-deleted by default.
model Employee {
  id             String         @id @default(uuid())
  employeeCode   String         @unique @map("employee_code")
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  email          String?        @unique
  phone          String?
  alternatePhone String?        @map("alternate_phone")
  dateOfBirth    DateTime?      @map("date_of_birth") @db.Date
  gender         Gender?
  nationality    String?
  address        String?
  jobTitle       String?        @map("position")
  department     String?
  joiningDate    DateTime?      @map("joining_date") @db.Date
  salary         Decimal?       @map("salary") @db.Decimal(12, 2)
  status         EmployeeStatus @default(ACTIVE)
  profileImageUrl String?       @map("profile_image_url")
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamptz(6)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  passports      Passport[]
  visas          Visa[]
  attendances    Attendance[]
  leaves         Leave[]
  documents      Document[]
  notifications  Notification[]
  payrollRecords PayrollRecord[]

  @@index([status])
  @@index([department])
  @@index([firstName])
  @@index([lastName])
  @@index([phone])
  @@index([jobTitle])
  @@index([deletedAt])
  @@map("employees")
}

/// documentUrl stores a private object-storage key, never a public file URL or binary data.
model Passport {
  id             String    @id @default(uuid())
  employeeId     String    @map("employee_id")
  employee       Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  passportNumber String?   @unique @map("passport_number")
  issueDate      DateTime? @map("issue_date") @db.Date
  expiryDate     DateTime? @map("expiry_date") @db.Date
  documentUrl    String?   @map("document_url")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeId])
  @@index([expiryDate])
  @@map("passports")
}

/// documentUrl stores a private object-storage key, never a public file URL or binary data.
model Visa {
  id          String    @id @default(uuid())
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  visaNumber  String?   @map("visa_number")
  visaType    String?   @map("visa_type")
  issueDate   DateTime? @map("issue_date") @db.Date
  expiryDate  DateTime? @map("expiry_date") @db.Date
  documentUrl String?   @map("document_url")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeId])
  @@index([expiryDate])
  @@index([visaNumber])
  @@map("visas")
}

/// source defaults to MANUAL. QR/GPS can be added later without changing the core attendance model.
/// One attendance row per employee per working date. Absence is calculated dynamically when no row exists.
model Attendance {
  id             String           @id @default(uuid())
  employeeId     String           @map("employee_id")
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  date           DateTime         @db.Date
  status         AttendanceStatus
  checkIn        DateTime?        @map("check_in") @db.Timestamptz(6)
  checkOut       DateTime?        @map("check_out") @db.Timestamptz(6)
  lateMinutes    Int?             @map("late_minutes")
  workingMinutes Int?             @map("working_minutes")
  notes          String?
  source         AttendanceSource @default(MANUAL)
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@map("attendances")
}

model Leave {
  id              String             @id @default(uuid())
  employeeId      String             @map("employee_id")
  employee        Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType       LeaveType          @map("leave_type")
  startDate       DateTime           @map("start_date") @db.Date
  endDate         DateTime           @map("end_date") @db.Date
  totalDays       Int                @map("total_days")
  reason          String?
  status          LeaveRequestStatus @default(PENDING)
  approvedById    String?            @map("approved_by")
  approvedBy      User?              @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt      DateTime?          @map("approved_at") @db.Timestamptz(6)
  rejectionReason String?            @map("rejection_reason")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([employeeId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
  @@map("leaves")
}

/// Customer invoices are independent of employee payroll. Totals are calculated on the backend.
model Invoice {
  id              String        @id @default(uuid())
  invoiceNumber   String        @unique @map("invoice_number")
  customerName    String        @map("customer_name")
  customerEmail   String?       @map("customer_email")
  customerPhone   String?       @map("customer_phone")
  customerAddress String?       @map("customer_address")
  invoiceDate     DateTime      @map("invoice_date") @db.Date
  dueDate         DateTime      @map("due_date") @db.Date
  status          InvoiceStatus @default(DRAFT)
  subtotal        Decimal       @db.Decimal(12, 2)
  taxAmount       Decimal       @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  items           InvoiceItem[]

  @@index([status])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([customerName])
  @@index([createdAt])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(12, 3)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([invoiceId])
  @@map("invoice_items")
}

/// One payroll row per employee per calendar month. Totals are calculated on the backend.
model PayrollRecord {
  id                    String                @id @default(uuid())
  employeeId            String                @map("employee_id")
  employee              Employee              @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  payrollMonth          Int                   @map("payroll_month")
  payrollYear           Int                   @map("payroll_year")
  basicSalary           Decimal               @map("basic_salary") @db.Decimal(12, 2)
  allowances            Decimal               @default(0) @db.Decimal(12, 2)
  overtimeAmount        Decimal               @default(0) @map("overtime_amount") @db.Decimal(12, 2)
  deductions            Decimal               @default(0) @db.Decimal(12, 2)
  unpaidLeaveDeduction  Decimal               @default(0) @map("unpaid_leave_deduction") @db.Decimal(12, 2)
  otherDeductions       Decimal               @default(0) @map("other_deductions") @db.Decimal(12, 2)
  unpaidLeaveDays       Int                   @default(0) @map("unpaid_leave_days")
  grossSalary           Decimal               @map("gross_salary") @db.Decimal(12, 2)
  netSalary             Decimal               @map("net_salary") @db.Decimal(12, 2)
  paymentStatus         PayrollPaymentStatus  @default(PENDING) @map("payment_status")
  paymentDate           DateTime?             @map("payment_date") @db.Date
  notes                 String?
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([employeeId, payrollMonth, payrollYear])
  @@index([employeeId])
  @@index([payrollYear, payrollMonth])
  @@index([paymentStatus])
  @@map("payroll_records")
}

/// fileUrl stores a private object-storage key. File bytes are never stored in PostgreSQL.
model Document {
  id             String       @id @default(uuid())
  employeeId     String       @map("employee_id")
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  documentType   DocumentType @map("document_type")
  documentNumber String?      @map("document_number")
  issueDate      DateTime?    @map("issue_date") @db.Date
  expiryDate     DateTime?    @map("expiry_date") @db.Date
  fileName       String       @map("file_name")
  fileUrl        String       @map("file_url")
  mimeType       String       @map("mime_type")
  fileSize       Int          @map("file_size")
  notes          String?
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  notifications  Notification[]

  @@index([employeeId])
  @@index([documentType])
  @@index([expiryDate])
  @@map("documents")
}

/// In-app admin notifications. eventKey prevents duplicate expiry events for the same document/date.
model Notification {
  id         String           @id @default(uuid())
  type       NotificationType
  title      String
  message    String
  employeeId String?          @map("employee_id")
  employee   Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  documentId String?          @map("document_id")
  document   Document?        @relation(fields: [documentId], references: [id], onDelete: SetNull)
  eventKey   String           @unique @map("event_key")
  isRead     Boolean          @default(false) @map("is_read")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  readAt     DateTime?        @map("read_at") @db.Timestamptz(6)

  @@index([isRead])
  @@index([createdAt])
  @@index([employeeId])
  @@index([documentId])
  @@index([type])
  @@map("notifications")
}

/// A backup may only be marked COMPLETED after the full backup process finishes successfully.
model BackupLog {
  id              String       @id @default(uuid())
  backupType      BackupType   @map("backup_type")
  status          BackupStatus
  fileName        String?      @map("file_name")
  storageLocation String?      @map("storage_location")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt     DateTime?    @map("completed_at") @db.Timestamptz(6)
  errorMessage    String?      @map("error_message")

  @@index([status])
  @@index([createdAt])
  @@map("backup_logs")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AppSetting {
  id        String        @id @default(uuid())
  key       AppSettingKey @unique
  value     Json
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}
